_payments&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;align=left;verticalAlign=top;spacingLeft=14;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="624" y="392" width="168" height="150" as="geometry"/></mxCell><mxCell id="silver_footer" value='&lt;span style="font-size:10px;color:#64748B;"&gt;dedupe · trim · cast&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:10px;color:#64748B;"&gt;orphan / null asserts&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;align=left;verticalAlign=top;spacingLeft=14;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="624" y="552" width="168" height="48" as="geometry"/></mxCell><mxCell id="gold" value='&lt;span style="font-size:14px;color:#B88A00;font-weight:bold;"&gt;Gold&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#64748B;"&gt;star schema (Delta)&lt;/span&gt;' style="swimlane;startSize=48;rounded=1;arcSize=6;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fillColor=#FBEFC4;swimlaneFillColor=#FFFDF5;strokeColor=#B88A00;strokeWidth=1.5;align=center;verticalAlign=middle;collapsible=0;" vertex="1" parent="1"><mxGeometry x="928" y="336" width="168" height="272" as="geometry"/></mxCell><mxCell id="gold_items" value='&lt;span style="font-size:11px;color:#1E293B;font-family:Consolas,monospace;"&gt;▸ gold_fact_payment&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#1E293B;font-family:Consolas,monospace;"&gt;▸ gold_dim_customer&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#1E293B;font-family:Consolas,monospace;"&gt;▸ gold_dim_corridor&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#1E293B;font-family:Consolas,monospace;"&gt;▸ gold_dim_currency&lt;/span&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#1E293B;font-family:Consolas,monospace;"&gt;▸ gold_dim_date&lt;/span&gt;' style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;align=left;verticalAlign=top;spacingLeft=14;spacingRight=0;" vertex="1" parent="1"><mxGeometry x="928" y="392" width="168